<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Mechrevo Drivers</vendor>
  <vendor_url>https://github.com/LIghtJUNction/mechrevo-drivers</vendor_url>
  <action id="org.mechrevo.console.oem">
    <description>Change a verified laptop device setting</description>
    <description xml:lang="zh_CN">修改已识别的笔记本设备设置</description>
    <message>Authentication is required to apply this device setting.</message>
    <message xml:lang="zh_CN">应用此设备设置需要管理员授权。</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mechrevo-console/oem-helper</annotate>
  </action>
</policyconfig>
